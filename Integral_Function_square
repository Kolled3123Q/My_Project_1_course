#include <stdio.h>
#include <math.h>
#include <stdlib.h>

double Height(double x){
    return 2*pow(x,3) + pow(x,2) + 3*x +11;
}

double Left_S(double a,double b,int steps){
    double delt_x = (a-b)/(steps*1.0);
    double S = 0;
    for (int i = 0;i < steps;i++){
       S = S + Height(delt_x*i + b)*delt_x;
    }
    return S;
}

double Integtal_S(double a,double b){
    double A = 0.5*pow(a,4) + (1.0/3.0)*pow(a,3) + 1.5*pow(a,2) + 11*a;
    double B = 0.5*pow(b,4) + (1.0/3.0)*pow(b,3) + 1.5*pow(b,2) + 11*b;
    return A-B;
}

