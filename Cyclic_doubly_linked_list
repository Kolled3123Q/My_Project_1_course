#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

typedef struct Node {
    double data;
    struct Node* next;
    struct Node* prev;
} Node;

typedef struct CircularList {
    Node* head;   
    int count;    
} CircularList;

CircularList* createList() {
    CircularList* list = (CircularList*)malloc(sizeof(CircularList));
    if (list == NULL) {
        printf("Ошибка выделения памяти для списка\n");
        return NULL;}
    list->head = NULL;
    list->count = 0;
    return list;}

Node* createNode(double data) {
    Node* newNode = (Node*)malloc(sizeof(Node));
    if (newNode == NULL) {
        printf("Ошибка выделения памяти для узла\n");
        return NULL;}
    newNode->data = data;
    newNode->next = NULL;
    newNode->prev = NULL;
    return newNode;}

bool isEmpty(CircularList* list) {
    return list == NULL || list->head == NULL;}

int getCount(CircularList* list) {
    if (list == NULL) return 0;
    return list->count;}

void recordNode(CircularList* list,double data){
    Node* NewNode = createNode(data);
    if(NewNode==NULL) return;
    
    if(isEmpty(list)){
        NewNode->next = NewNode;
        NewNode->prev = NewNode;
        list->head=NewNode;
    } else {
        Node* last = list->head->prev;
        
        NewNode->next = list->head;
        NewNode->prev=last;
        
        last->next=NewNode;
        list->head->prev=NewNode;
        
        list->head=NewNode;}
    list->count++;}

double ReadList(CircularList* list,int index){
    if (isEmpty(list)){
        return -1;}
    
    index = index %list->count;
    if (index<0){index=index+list->count;}
    Node* current = list->head;
    for(int i = 0;i<index;i++){
        current=current->next;}
    return current->data;}

int SearchNode(CircularList* list,double data){
    if (isEmpty(list)){
        return -1;}
    Node* current = list->head;
    for(int i = 0;i<list->count;i++){
        if (current->data == data){
            return i;}
        current=current->next;}
    return -2;}

void deleteNode(CircularList* list, Node* data) {
    if (isEmpty(list) || data == NULL) return;
    if (data->next == data && data->prev == data) {
        list->head = NULL;
    } else {
        data->prev->next = data->next;
        data->next->prev = data->prev;
        if (data == list->head) {
            list->head = data->next;} }
    free(data);
    list->count--;}

void deleteList(CircularList** list) {
    if (list == NULL || *list == NULL) return;
    CircularList* tempList = *list;
    if (!isEmpty(tempList)) {
        Node* current = tempList->head;
        Node* nextNode;
        do {
            nextNode = current->next;
            free(current);
            current = nextNode;
        } while (current != tempList->head);}
    free(tempList); 
    *list = NULL;
    printf("Список полностью удален\n");}


